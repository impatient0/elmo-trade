---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Map from "../components/Map.astro";
import "../styles/global.css";
const { pageTitle, pageID } = Astro.props;
import { ClientRouter } from 'astro:transitions';
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<!-- <ClientRouter /> -->
	</head>
	<body id={pageID}>
		<Header />
		<slot />
		<div class="about" id="contacts">
			<p class="title1">Заинтересовались? Обращайтесь.</p>
			<p class="headline1">контакты нашего офиса в петербурге</p>
			<p class="body1">
				По всем интересующим Вас вопросам звоните нам с понедельника по
				пятницу с 10:00 до 17:00 по номеру +7 (812) 370-22-61 или
				приезжайте к нам в офис.
			</p>
		</div>
		<Map />
		<Footer />
	</body>
</html>
