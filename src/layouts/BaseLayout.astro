---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Map from "../components/Map.astro";
import "../styles/global.css";
const { pageTitle, pageID } = Astro.props;
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<script
			src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"
		></script>
	</head>
	<body id={pageID}>
		<Header />
		<slot />
		<div class="about" id="contacts">
			<p class="title1">Заинтересовались? Обращайтесь.</p>
			<p class="headline1">контакты нашего офиса в петербурге</p>
			<p class="body1">
				По всем интересующим Вас вопросам звоните нам с понедельника по
				пятницу с 09.00 до 18.00 по номеру 8 (812) 603 76 96 или
				приезжайте к нам в офис.
			</p>
		</div>
		<Map width="1440" height="600" />
		<Footer />
	</body>
</html>
