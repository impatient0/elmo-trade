---
import BaseLayout from "./BaseLayout.astro";
import Carousel from "../components/Carousel";
import MultiGallery from "../components/MultiGallery";
import ProjectCarousel from "../components/ProjectCarousel";
import { slide } from "astro:transitions";
const { frontmatter } = Astro.props;

const allProjects = await Astro.glob("../pages/projects/*.md");
const slides = allProjects.map((project) => ({image: project.frontmatter.info.slide_image, year: project.frontmatter.info.year, title: project.frontmatter.title, link: project.url, address: project.frontmatter.info.address, info: project.frontmatter.info.description, }));
---

<BaseLayout pageTitle={frontmatter.title} pageID={frontmatter.pageID}>
	<div class="cover">
		<Carousel
			client:load
			images={[
				{
					image: frontmatter.info.cover_image,
					description: {
						title: frontmatter.info.year.join(" "),
						headline: frontmatter.title,
						subbody: frontmatter.info.address,
						body: frontmatter.info.description,
					},
				},
			]}
		/>
	</div>
	{frontmatter.sections.map((section) => (
		<div class="about">
			<p class="title1">{section.about.header}</p>
			<p class="body1">{section.about.body}</p>
		</div>
		<MultiGallery client:load sections={section.multi_gallery} />
	))}
	<div id="made_on">
		<p class="body1">Другие проекты:</p>
	</div>
	<ProjectCarousel client:load slides={slides} />
	<script
		is:inline
		src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"
	></script>
	<script src="../scripts/ServicePage.js"></script>
</BaseLayout>
