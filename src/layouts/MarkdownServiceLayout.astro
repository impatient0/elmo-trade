---
import BaseLayout from "./BaseLayout.astro";
import Carousel from "../components/Carousel.astro";
import MultiGallery from "../components/MultiGallery.astro";
import Projects from "../components/Projects.astro";

import { getImage } from "astro:assets";

const allServiceImages = import.meta.glob('/src/assets/images/services/**/*.{webp,jpg,jpeg,png,gif,svg,avif}');

const { frontmatter } = Astro.props;

const optimizedMultiGallery = await Promise.all(
    frontmatter.multi_gallery.map(async (gallery) => {
        const optimizedImages = await Promise.all(
            gallery.images.map(async (imagePath) => {
                if (!/\.(webp|jpg|jpeg|png|gif|svg|avif)$/.test(imagePath)) {
                    return { src: imagePath, type: 'video' };
                }
                
                const globKey = `${imagePath.replace('../..', '/src')}`;

                if (allServiceImages[globKey]) {
                    const imageModule = await allServiceImages[globKey]();
                    return { src: (imageModule as Record<string, any>).default, type: 'image' };
                }
                
                console.warn(`Image not found in glob: ${globKey}`);
                return { src: imagePath, type: 'error' };
            })
        );
        return { ...gallery, images: optimizedImages };
    })
);

const serviceFilter = (p) => {
	return p.services?.includes(frontmatter.pageID);
};
---

<BaseLayout pageTitle={frontmatter.title} pageID={frontmatter.pageID}>
	<div class="cover">
		<Carousel images={frontmatter.carousel.images} />
	</div>
	<div class="about gallery-section-title" id="gallery-section_0">
		<p class="title1">{frontmatter.about.header}</p>
		<p class="body1">{frontmatter.about.body}</p>
	</div>
	<MultiGallery
		sections={optimizedMultiGallery}
		shifts={"shifts" in frontmatter ? frontmatter.shifts : null}
	/>
	<div id="made_on">
		<p class="body1">Выполнено на:</p>
	</div>
	<Projects filter={serviceFilter} />

    <style>
        #gallery-section_0 {
            padding-top: 64px;
            padding-bottom: 48px;
        }
        
        @media (max-width: 768px) {
            #gallery-section_0 {
                padding: 32px 5%;
            }
        }
    </style>
</BaseLayout>
