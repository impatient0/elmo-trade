---
import BaseLayout from "./BaseLayout.astro";
import Carousel from "../components/Carousel";
import MultiGallery from "../components/MultiGallery";
import ProjectCarousel from "../components/ProjectCarousel";
import Projects from "../components/Projects.astro";


const { frontmatter } = Astro.props;
const allProjects = await Astro.glob("../pages/projects/*.md");
const filteredProjects = allProjects.filter((project) =>
	project.frontmatter.services?.includes(frontmatter.pageID),
);
const slides = filteredProjects.map((project) => ({
	image: project.frontmatter.info.slide_image,
	year: project.frontmatter.info.year,
	title: project.frontmatter.title,
	link: project.url,
	address: project.frontmatter.info.address,
	info: project.frontmatter.info.description,
	services: project.frontmatter.services,
}));
---

<BaseLayout pageTitle={frontmatter.title} pageID={frontmatter.pageID}>
	<div class="cover">
		<Carousel client:load images={frontmatter.carousel.images} />
	</div>
	<div class="about gallery-section-title" id="gallery-section_0">
		<p class="title1">{frontmatter.about.header}</p>
		<p class="body1">{frontmatter.about.body}</p>
	</div>
	<MultiGallery client:load sections={frontmatter.multi_gallery} shifts={"shifts" in frontmatter ? frontmatter.shifts : null}/>
	<div id="made_on">
		<p class="body1">Выполнено на:</p>
	</div>
	<div id="project_carousel">
		<ProjectCarousel client:load slides={slides} />
	</div>
	<script
		is:inline
		src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"
	></script>
	<script src="../scripts/ServicePage.js"></script>
</BaseLayout>
