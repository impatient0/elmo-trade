---
import BaseLayout from "./BaseLayout.astro";
import Carousel from "../components/Carousel";
import MultiGallery from "../components/MultiGallery";
import Projects from "../components/Projects.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} pageID={frontmatter.pageID}>
	<div class="cover">
		<Carousel
			client:load
			images={[
				{
					image: frontmatter.info.cover_image,
					description: {
						title: frontmatter.info.year.join(" "),
						headline: frontmatter.title,
						subbody: frontmatter.info.address,
						body: frontmatter.info.description,
					},
				},
			]}
		/>
	</div>
	<div class="about gallery-section-title" id="gallery-section_0">
		<p class="title1">{frontmatter.about.header}</p>
		<p class="body1">{frontmatter.about.body}</p>
	</div>
	<MultiGallery client:load sections={frontmatter.multi_gallery} shifts={"shifts" in frontmatter ? frontmatter.shifts : null}/>
	<div id="made_on">
		<p class="body1">Другие проекты:</p>
	</div>
	<Projects />
	<script
		is:inline
		src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"
	></script>
	<script src="../scripts/ServicePage.js"></script>
</BaseLayout>
