---
import { getCollection } from 'astro:content'; // 1. Import getCollection
import Projects from "../components/Projects.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCarousel from "../components/ProjectCarousel";

const allProjects = await getCollection("projects");

const projectTitles = allProjects.map((project) => project.data.title);

const slides = allProjects.map((project) => ({
    image: project.data.info.slide_image,
    year: project.data.info.year,
    title: project.data.title,
    link: `/projects/${project.id}`,
    address: project.data.info.address,
    info: project.data.info.description,
}));
---

<BaseLayout pageTitle={"test"} pageID={"test"}>
    <div class="about">
        {projectTitles.map((title) => <p class="body1">{title}</p>)}
    </div>
    <ProjectCarousel client:load slides={slides} />
</BaseLayout>