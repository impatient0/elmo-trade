---
import Projects from "../components/Projects.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCarousel from "../components/ProjectCarousel";

const allProjects = await Astro.glob("./projects/*.md");
const projectTitles = allProjects.map((project) => project.frontmatter.title);
// const slides = allProjects.map((project) => ({image: project.frontmatter.carousel.images[0].image, title: project.frontmatter.title, year: [project.frontmatter.carousel.images[0].description.title], link: project.url, address: project.frontmatter.carousel.images[0].description.subbody, info: project.frontmatter.carousel.images[0].description.body}));
const slides = allProjects.map((project) => ({image: project.frontmatter.info.slide_image, year: project.frontmatter.info.year, title: project.frontmatter.title, link: project.url, address: project.frontmatter.info.address, info: project.frontmatter.info.description, }));
---

<BaseLayout pageTitle={"test"} pageID={"test"}>
    <div class="about">
        {projectTitles.map((title) => <p class="body1">{title}</p>)}
    </div>
    <ProjectCarousel client:load slides={slides} />
</BaseLayout>
