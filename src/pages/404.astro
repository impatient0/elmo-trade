---
import Footer from "../components/Footer.astro";
import "../styles/global.css";
const pageTitle = "Такой страницы пока нет...";
const pageID = "404";
---

<html lang="ru">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
            rel="stylesheet"
        />
        <title>{pageTitle}</title>
    </head>
    <body id={pageID}>
        <div id="shrek">
            <div id="escape">
                <p>Ошибка <b>404</b>: такой страницы пока нет</p>
                <div id="button_container">
                    <button onclick={"window.location.href='/';"}
                        >Назад на главную
                    </button></div>
            </div>
        </div>
        <Footer />
    </body>
</html>

<style>
    :root {
        --shrek-color: white;
    }

    body {
        max-width: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        justify-items: flex-end;
    }

    #shrek {
        width: 100%;
        height: calc(100vh - 119px);
        background-image: url(/img/404.gif);
        background-size: cover;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    #escape {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        &>p {
            font-size: 64px;
            font-weight: 600;
            color: var(--shrek-color);
            text-wrap: wrap;
            max-width: 85%;
            text-align: center;

            &>b {
                font-weight: 800;
            }
        }

        &>#button_container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;

            &>button {
                padding: 20px;
                font-size: 48px;
                color: var(--shrek-color);
                cursor: pointer;
                border: 2px solid var(--shrek-color);
                border-radius: 20px;
                background: none;
                transition: all .5s ease;
                animation: swing 2s linear infinite;

                &:hover {
                    animation: swing .5s linear infinite;
                    transform: rotate(720deg);
                }
            }
        }
    }

    @keyframes swing {
        0% {
            transform: rotate(0deg) scale(.95);
        }

        25% {
            transform: rotate(1deg) scale(1);
        }

        50% {
            transform: rotate(0deg) scale(.95);
        }

        75% {
            transform: rotate(-1deg) scale(1);
        }

        100% {
            transform: rotate(0deg) scale(.95);
        }
    }

    @keyframes grow {
        from {
            transform: scale(1);
        }

        to {
            transform: scale(10);
        }
    }

    footer {
        background-color: var(--shrek-color);
    }
</style>
