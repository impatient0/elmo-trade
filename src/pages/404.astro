---
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/404.css";
const pageTitle = "Такой страницы пока нет...";
const pageID = "404";
---

<html lang="ru">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
            rel="stylesheet"
        />
        <title>{pageTitle}</title>
        <script
            src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"
        ></script>
    </head>
    <body id={pageID}>
        <div class="shrek">
            <p>Ошибка 404: такой страницы пока нет</p>
            <button onclick={"window.location.href='/';"}>Назад на главную</button>
        </div>
        <Footer />
    </body>
</html>
