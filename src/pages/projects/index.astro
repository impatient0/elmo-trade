---
import { getCollection } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";
import DynamicGallery from "../../components/DynamicGallery";
import Carousel from "../../components/Carousel";

import { getImage } from "astro:assets";
import izmeronImage from "../../assets/images/projects/izmeron/izmeron.webp";
import spguImage from "../../assets/images/projects/obshchezhitie-spgu-(gornyi-universitet)/obshchezhitie-spgu-(gornyi-universitet).webp";
import mtsImage from "../../assets/images/projects/stroitelnaia-ploshchadka-tsod-mts/stroitelnaia-ploshchadka-tsod-mts.webp";

const pageTitle = "Проекты";

const rawCarouselData = [
	{
		image: izmeronImage,
		offsets: [0, -150],
		size: [0, 0],
		description: {
			title: "2019-2022",
			headline: "Завод “Измерон”",
			subbody: "г. Санкт-Петербург, ул. Броневая 5.",
			body: "Реконструкция РТП и монтаж кабельных линий 10 кВ и 0,4 кВ для электроснабжения ОО НПФ Завод “Измерон”.",
		},
		link: "/projects/zavod-izmeron",
	},
	{
		image: spguImage,
		offsets: [0, -175],
		size: [0, 0],
		description: {
			title: "2022-2023",
			headline: "Общежитие спгу (горный университет) ",
			subbody: "г. Санкт-Петербург, 14-я линия В.О., д. 77, литер А.",
			body: "Разработка РД и выполнение работ по монтажу внутренних инженерных систем.",
		},
		link: "/projects/obshchezhitie-spgu-(gornyi-universitet)",
	},
	{
		image: mtsImage,
		offsets: [0, -200],
		size: [0, 0],
		description: {
			title: "2017-2019",
			headline: "ЦОД МТС",
			subbody: "г. Санкт-Петербург, Оборонная ул., 29",
			body: "Временное электроснабжение и освещение строительной площадки ЦОД МТС.",
		},
		link: "/projects/tsod-mts",
	},
];

const optimizedCarouselImages = await Promise.all(
    rawCarouselData.map(async (imgData) => {
        const optimized = await getImage({
            src: imgData.image,
            width: imgData.size[0],
            format: 'webp',
        });
        return { ...imgData, optimizedImageSrc: optimized.src };
    })
);

const compareYears = (a, b) => {
    let a_1 = a.year[a.year.length - 1].slice(-4);
    let a_2 = a.year[a.year.length - 1].slice(0, 4);
    let b_1 = b.year[b.year.length - 1].slice(-4);
    let b_2 = b.year[b.year.length - 1].slice(0, 4);
    if (a_1 == b_1) {
        return a_2 > b_2 ? -1 : 1;
    }
    return a_1 > b_1 ? -1 : 1;
}

const allProjects = await getCollection('projects');

const slides = await Promise.all(
    allProjects.map(async (project) => {
        const optimized = await getImage({
            src: project.data.info.slide_image as ImageMetadata,
			width: project.data.info.slide_image.width,
			format: 'webp'
        });

        return {
            year: project.data.info.year, 
            title: project.data.title,
            link: `/projects/${project.id}`, 
            address: project.data.info.address, 
            info: project.data.info.description,
            optimizedSrc: optimized.src,
            offsets: project.data.info.slide_image_offsets || [0, 0],
        };
    })
);

slides.sort(compareYears);
---

<BaseLayout pageTitle={pageTitle}>
	<div class="cover">
		<Carousel client:load images={optimizedCarouselImages} />
	</div>
    <div class="about">
        <p class="title1">Проекты</p>
        <p class="headline1">ознакомьтесь с нашей работой</p>
        <p class="body1">За более чем 20-ти летний период мы оборудовали инженерными системами большие количество объектов.</p>
    </div>
    <DynamicGallery client:load slides={slides}/>
</BaseLayout>
