---
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "../components/Carousel.astro";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import Letters from "../components/Letters.astro";

import izmeronImage from "../assets/images/projects/izmeron/izmeron.webp";
import spguImage from "../assets/images/projects/obshchezhitie-spgu-(gornyi-universitet)/obshchezhitie-spgu-(gornyi-universitet).webp";
import mtsImage from "../assets/images/projects/stroitelnaia-ploshchadka-tsod-mts/stroitelnaia-ploshchadka-tsod-mts.webp";

const pageTitle = "Элмо Трейд";
const pageID = "home";

const carouselImages = [
	{
		src: izmeronImage,
		offsets: [0, -150],
		size: [0, 0], // Use 0,0 to signify 'cover'
		description: {
			title: "2019-2022",
			headline: "Завод “Измерон”",
			subbody: "г. Санкт-Петербург, ул. Броневая 5.",
			body: "Реконструкция РТП и монтаж кабельных линий 10 кВ и 0,4 кВ для электроснабжения ОО НПФ Завод “Измерон”.",
		},
		link: "/projects/zavod-izmeron",
	},
	{
		src: spguImage,
		offsets: [0, -175],
		size: [0, 0],
		description: {
			title: "2022-2023",
			headline: "Общежитие спгу (горный университет) ",
			subbody: "г. Санкт-Петербург, 14-я линия В.О., д. 77, литер А.",
			body: "Разработка РД и выполнение работ по монтажу внутренних инженерных систем.",
		},
		link: "/projects/obshchezhitie-spgu-gornyi-universitet",
	},
	{
		src: mtsImage,
		offsets: [0, -200],
		size: [0, 0],
		description: {
			title: "2017-2019",
			headline: "ЦОД МТС",
			subbody: "г. Санкт-Петербург, Оборонная ул., 29",
			body: "Временное электроснабжение и освещение строительной площадки ЦОД МТС.",
		},
		link: "/projects/tsod-mts",
	},
];

const yearFilter = (x) => {
	let currentYear = new Date().getFullYear();
	return Number(x.year[x.year.length - 1].slice(-4)) >= 2023;
	// TODO: update when more projects are available
	// return Number(x.year[x.year.length - 1].slice(-4)) >= currentYear - 1;
};
---

<BaseLayout pageTitle={pageTitle} pageID={pageID}>
	<div class="cover">
		<Carousel images={carouselImages} showDots={true} />
	</div>
	<div class="about">
		<p class="title1">Выполнен широкий спектр работ</p>
		<p class="headline1">с 2001 года</p>
		<p class="body1">
			ООО НПП «ЭЛМО трейд» занимается проектированием, монтажом и
			техническим обслуживанием инженерных систем и систем обеспечения
			противопожарной безопасности любой сложности с применением как
			отечественного так и импортного оборудования в городе
			Санкт-Петербурге и его ближайшем пригороде.
		</p>
	</div>
	<Services />
	<div class="about" id="projects">
		<div class="desktop-content">
			<p class="title1">Проекты</p>
			<p class="headline1">ознакомьтесь с нашей работой</p>
			<p class="body1">За более чем 20-ти летний период мы оборудовали инженерными системами большое количество объектов.</p>
		</div>
		<div class="mobile-content">
			<p class="title1">За более чем 20-ти летний период мы оборудовали инженерными системами большое количество объектов.</p>
			<p class="headline1">наши проекты</p>
			<a href="/projects" class="view-project-btn" aria-label={`View projects`}>
				<span class="arrow"></span>
			</a>
		</div>
	</div>
	<Projects filter={yearFilter} />
	<div class="about" id="partners">
		<p class="title1">Благодарственные письма от наших</p>
		<p class="headline1">партнеров</p>
		<p class="body1">
			Сотрудничаем на постоянной основе с девелоперами, застройщиками и
			промышленными предприятиями.
		</p>
	</div>
	<Letters />
</BaseLayout>

<style>	
	.view-project-btn {
		flex-shrink: 0; /* Prevents the button from shrinking */
		position: absolute;
		top: 86%;
		right: 0;
		left: auto;
		transform: translateY(-50%);
		cursor: pointer;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background-color: rgba(0, 0, 0, 0.0);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.3s ease;        
	}

	.view-project-btn:hover {
		transform: translate(10px, -50%);
	}

    .arrow {
        position: relative;
        width: 17px;
        height: 17px;
    }

    .arrow::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 17px;
        height: 17px;
        border-style: solid;
        border-color: var(--color-background-html);
        border-width: 2px 2px 0 0;
        transform: translate(-65%, -50%) rotate(45deg);
    }
</style>
