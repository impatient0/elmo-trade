---
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "../components/Carousel";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import Letters from "../components/Letters.astro";
const pageTitle = "Элмо Трейд";
const pageID = "home";
const images = [
	{
		image: ["/img/projects/project-2.webp", 0, -150, 0, 0],
		description: {
			title: "2019-2022",
			headline: "ЗАВОД ИЗМЕРОН",
			subbody: "г. Санкт-Петербург, ул. Броневая, д. 5",
			body: "Выполнен комплекс строительно-монтажных работ по реконструкции административно-бытового здания Корпус № 1, №2. ",
		},
	},
	{
		image: ["/img/projects/project-4.webp", 0, -100, 0, 0],
		description: {
			title: "2022-2023",
			headline: "Общежитие спгу (горный университет) ",
			subbody: "г. Санкт-Петербург, 14-я линия В.О., д. 77, литер А.",
			body: "Разработка РД и выполнение работ по монтажу внутренних инженерных систем (ЭОМ, АПС, СОУЭ, АППЗ, система контроля доступа, охранная сигнализация, система охранного телевидения, диспетчеризация).",
		},
	},
	{
		image: ["/img/projects/project-1.webp", 0, -350, 1800, 1355],
		description: {
			title: "2020",
			headline: "центр обработки данных «МТС»",
			subbody: "Ленинградская область, Тосненский район, массив «Федоровское», уч. Восточный № 43/44-3/18",
			body: "Выполнен комплекс работ по устройству наружных и внутренних инженерных сетей объекта.",
		},
	},
];
---

<BaseLayout pageTitle={pageTitle} pageID={pageID}>
	<div class="cover">
		<Carousel client:load images={images} />
	</div>
	<div class="about">
		<p class="title1">Выполняем широкий спектр работ</p>
		<p class="headline1">с 2001 года</p>
		<p class="body1">
			ООО НПП «ЭЛМО трейд» занимается проектированием, монтажом и
			техническим обслуживанием инженерных систем и систем обеспечения
			противопожарной безопасности любой сложности с применением как
			отечественного так и импортного оборудования в городе
			Санкт-Петербурге и его ближайшем пригороде.
		</p>
	</div>
	<Services />
	<div class="about" id="projects">
		<p class="title1">Проекты</p>
		<p class="headline1">ознакомьтесь с нашей работой</p>
		<p class="body1">
			За более чем 20-ти летний период мы оборудовали инженерными
			системами большие количество объектов.
		</p>
	</div>
	<!-- <Projects /> -->
	<div class="about" id="partners">
		<p class="title1">Благодарственные письма от наших</p>
		<p class="headline1">партнеров</p>
		<p class="body1">
			Сотрудничаем на постоянной основе с девелоперами, застройщиками и
			промышленными предприятиями.
		</p>
	</div>
	<Letters />
</BaseLayout>
