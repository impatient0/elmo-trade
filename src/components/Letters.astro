---
import "../styles/letters.css";
import LettersGallery from "../components/LettersGallery";
const letters = [
    {
        logo: "/img/partners/arteks.png",
        title: "“Система противопожарной защиты предъявлена контролирующим органам и принята в эксплуатацию.”",
