---
import "../styles/footer.css";
const columns = [
    {
        title: { text: "About", link: "#" },
        links: [
            { text: "How it works", link: "#" },
            { text: "Featured", link: "#" },
            { text: "Partnership", link: "#" },
            { text: "Bussiness Relation", link: "#" },
        ],
    },
    {
        title: { text: "Community", link: "#" },
        links: [
            { text: "Events", link: "#" },
            { text: "Blog", link: "#" },
            { text: "Podcast", link: "#" },
            { text: "Invite a friend", link: "#" },
        ],
    },
    {
        title: { text: "Socials", link: "#" },
        links: [
            { text: "Discord", link: "#" },
            { text: "Instagram", link: "#" },
            { text: "Twitter", link: "#" },
            { text: "Facebook", link: "#" },
        ],
    },
];
---

<footer class="footer-top">
    <div>
        <img src="/img/logo-2.svg" class="logo" />
        <p class="slogan">Revolutionizing safety for an uncertain future</p>
    </div>
    <div class="footer-columns-container">
        {
            columns.map((column) => (
                <div class="footer-column">
                    <a href={column.title.link} class="footer-title-link">
                        <b>{column.title.text}</b>
                    </a>
                    {column.links.map((link) => (
                        <a href={link.link} class="footer-link">
                            {link.text}
                        </a>
                    ))}
                </div>
            ))
        }
    </div>
</footer>
<footer class="footer-bottom">
    <a>©2024 Ochello. All rights reserved</a>
    <div id="pptc">
        <a href="#">Privacy & Policy</a>
        <a href="#">Terms & Condition</a>
    </div>
</footer>
