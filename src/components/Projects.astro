---
import { slide } from "astro:transitions";
import ProjectCarousel from "./ProjectCarousel";

const props = Astro.props;

const compareYears = (a, b) => {
    let a_1 = a.year[a.year.length - 1].slice(-4);
    let a_2 = a.year[a.year.length - 1].slice(0, 4);
    let b_1 = b.year[b.year.length - 1].slice(-4);
    let b_2 = b.year[b.year.length - 1].slice(0, 4);
    if (a_1 == b_1) {
        return a_2 > b_2 ? -1 : 1;
    }
    return a_1 > b_1 ? -1 : 1;
}

const stub = {
    image: ["/img/elmo-shrug.gif", 0, 0, 0, 0],
    year: ["0"],
    title: "",
    link: null,
    address: "",
    info: "Здесь мог бы быть Ваш проект :)",
    services: [],
}
const allProjects = await Astro.glob("../pages/projects/*.md");
const slides = allProjects.map((project) => ({
    image: project.frontmatter.info.slide_image,
    year: project.frontmatter.info.year,
    title: project.frontmatter.title,
    link: project.url,
    address: project.frontmatter.info.address,
    info: project.frontmatter.info.description,
    services: project.frontmatter.services,
})).filter(props.filter != null ? props.filter : (x) => true);
slides.sort(compareYears);
while (slides.length < 2) {
    slides.push(stub);
}
---

<div id="project_carousel">
    <ProjectCarousel client:load slides={slides} />
</div>
