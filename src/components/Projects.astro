---
import { getCollection } from "astro:content";
import { slide } from "astro:transitions";
import ProjectCarousel from "./ProjectCarousel";

const props = Astro.props;

const compareYears = (a, b) => {
    let a_1 = a.year[a.year.length - 1].slice(-4);
    let a_2 = a.year[a.year.length - 1].slice(0, 4);
    let b_1 = b.year[b.year.length - 1].slice(-4);
    let b_2 = b.year[b.year.length - 1].slice(0, 4);
    if (a_1 == b_1) {
        return a_2 > b_2 ? -1 : 1;
    }
    return a_1 > b_1 ? -1 : 1;
}

interface Stub {
    image: [string, number, number, number, number];
    year: string[];
    title: string;
    link: string | null;
    address: string;
    info: string;
    services: any[];
}

const stub : Stub = {
    image: ["/img/elmo-shrug.gif", 0, 0, 0, 0],
    year: ["0"],
    title: "",
    link: null,
    address: "",
    info: "Здесь мог бы быть Ваш проект :)",
    services: [],
}

const allProjects = await getCollection("projects");

const slides = allProjects.map((project) => ({
    image: project.data.info.slide_image,
    year: project.data.info.year,
    title: project.data.title,
    link: `/projects/${project.id}`,
    address: project.data.info.address,
    info: project.data.info.description,
    services: project.data.services,
})).filter(props.filter != null ? props.filter : (x) => true);

slides.sort(compareYears);

while (slides.length < 2) {
    slides.push(stub);
}
---

<div id="project_carousel">
    <ProjectCarousel client:load slides={slides} />
</div>
