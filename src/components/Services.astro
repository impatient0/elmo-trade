---
import "../styles/services.css";
import Service from "../components/Service";
const title1 = "ЭЛЕКТРОМОНТАЖНЫЕ РАБОТЫ";
const description1 = "Подключение потребителей к электросети, обеспечение стабильной подачи электроэнергии с соблюдением проектных параметров";
const image1 = "/img/services/service3.png";
const title2 = "СИСТЕМЫ ПРОТИВОПОЖАРНОЙ ЗАЩИТЫ И АВТОМАТИКИ";
const image2 = "/img/services/service2.png";
---

<div class="services">
    <div class="services-gallery">
        <Service title={title1} description={description1} image={image1} id="service-1" />
        <Service title={title2} description={description1} image={image2} id="service-2" />
    </div>
</div>
<script>
    import "../scripts/Service";
</script>
