---
import { getImage } from 'astro:assets';
import "../styles/services.css";
import Service from "../components/Service";

import serviceImage1 from "../assets/images/services/elektromontazhnye-raboty/tp-i-rtp/tp-i-rtp01.webp";
import serviceImage2 from "../assets/images/services/service-2.webp";
import serviceImage3 from "../assets/images/services/service-3.webp";
import serviceImage4 from "../assets/images/services/service-4.webp";
import serviceImage5 from "../assets/images/services/service-5.webp";
import serviceImage6 from "../assets/images/services/service-6.webp";
import serviceImage7 from "../assets/images/services/service-7.webp";
import serviceImage8 from "../assets/images/services/service-8.webp";
import serviceImage9 from "../assets/images/services/service-9.webp";

const rawServicesData = [
    {
        title: ["Электромонтажные работы"],
        description:
            "Монтаж наружних и внутренних сетей электроснабжение до 35 кВ, строительство, монтаж и пусконакладочные работы трансформаторных и распределительных подстанций.",
        image: serviceImage1, offsets: [-126, -95], size: [646, 484],
        link: "/services/elektromontazhnye-raboty",
    },
    {
        title: ["системы обеспечения", "пожарной безопасности"],
        description:
            "Проектирование, монтаж и обслуживание систем пожаротушения автоматических пожарно-охранных сигнализаций и систем оповещения и управления эвакуацией.",
        image: serviceImage2, offsets: [-2, -26], size: [400, 300],
        link: "/services/sistemy-obespecheniya-pozharnoj-bezopasnosti",
    },
    {
        title: ["Системы вентиляции", "и кондиционирования"],
        description:
            "Монтаж и  автоматизация систем вентиляции и кондиционирования.",
        image: serviceImage3, offsets: [0, -97], size: [392, 294],
        link: "/services/sistemy-ventelyacii-i-kondicionirovaniya",
    },
    {
        title: ["Система контроля", "и управления доступом"],
        description:
            "Установка турникетов, металлодетекторов, шлакбаумов, пропускных пунктов, систем контроля и разблокировки дверей.",
        image: serviceImage4, offsets: [-203, -17], size: [636, 477],
        link: "/services/sistemy-kontrolia-i-upravleniia-dostupom",
    },
    {
        title: ["Системы видеонаблюдения", "и охранные сигнализации"],
        description:
            "Проектирование и монтаж систем видеонаблюдения, охранных сигнализаций, систем охраны периметра.",
        image: serviceImage5, offsets: [-52, -237], size: [543, 724],
        link: "/services/sistemy-videonabliudeniia-i-okhrannye-signalizatsii",
    },
    {
        title: ["Структурированная", "кабельная сеть"],
        description:
            "Монтаж наружних и внутренних электрических сетей.",
        image: serviceImage6, offsets: [-6, -98], size: [372, 496],
        link: "/services/strukturirovannaya-kabelnaya-set",
    },
    {
        title: ["водоснабжение и канализация"],
        description:
            "Полный комплекс работ по водоснабжению, водоотведению, внутреннему противопожарному водопроводу.",
        image: serviceImage7, offsets: [-56, -126], size: [462, 616],
        link: "/services/vodosnabzhenie-i-kanalizaciya",
    },
    {
        title: ["Теплоснабжение"],
        description:
            "Монтаж ИТП и разводка сетей теплоснабжения.",
        image: serviceImage8, offsets: [-16, -169], size: [411, 548],
        link: "/services/teplosnabzhenie",
    },
    {
        title: ["комплектация проектными", "дверными конструкциями"],
        description:
            "Являемся авторизованным диллером широкого ассортимента деревянных дверей фабрики FORMO для комплектации коммерческих объектов. ",
        image: serviceImage9, offsets: [0, -127], size: [396, 528],
        link: "/services/komplektaciya-proektnymi-dvernymi-konstrukciyami",
    },
];

const optimizedServices = await Promise.all(
    rawServicesData.map(async (service, index) => {
        const optimized = await getImage({
            src: service.image,
            width: service.image.width,
            format: 'webp',
        });
        return {
            ...service,
            optimizedSrc: optimized.src,
            id: `service-${index}`,
        };
    })
);
---

<div class="services" id="services">
    <div class="services-gallery">
        {
            optimizedServices.map((service) => (
                <Service
                    title={service.title}
                    description={service.description}
                    optimizedSrc={service.optimizedSrc}
                    offsets={service.offsets}
                    size={service.size}
                    link={service.link}
                    id={service.id}
                />
            ))
        }
    </div>
</div>
<script>
    import '../scripts/Service';
</script>
