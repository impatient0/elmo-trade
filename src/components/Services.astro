---
import "../styles/services.css";
import Service from "../components/Service";
const services = [
    {
        title: "ЭЛЕКТРОМОНТАЖНЫЕ РАБОТЫ",
        description:
            "Подключение потребителей к электросети, обеспечение стабильной подачи электроэнергии с соблюдением проектных параметров",
        image: "/img/services/service3.png",
    },
    {
        title: "СИСТЕМЫ ПРОТИВОПОЖАРНОЙ ЗАЩИТЫ И АВТОМАТИКИ",
        description:
            "Подключение потребителей к электросети, обеспечение стабильной подачи электроэнергии с соблюдением проектных параметров",
        image: "/img/services/service2.png",
    },
    {
        title: "системы контроля и управления доступом",
        description:
            "Подключение потребителей к электросети, обеспечение стабильной подачи электроэнергии с соблюдением проектных параметров",
        image: "/img/services/service3.png",
    },
];
---

<div class="services">
    <div class="services-gallery">
        {services.map((service, index) => (
            <Service
                title={service.title}
                description={service.description}
                image={service.image}
                id={"service-" + index}
            />
        ))}
    </div>
    <button class="show-all-btn" onclick="window.location.href='/services'"
        >Показать всё</button
    >
</div>
<script>
    import "../scripts/Service";
</script>
