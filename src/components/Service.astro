---
import { Image } from "astro:assets";
const { title, description, image, offsets, size, link } = Astro.props;
---

<a href={link} class="service-container">
    <div class="image-wrapper">
        <Image 
            src={image}
            class="service-image"
            style={`--pos-x: ${offsets[0]}px; --pos-y: ${offsets[1]}px;`}
            alt={`${title.join(' ')} service`}
            width={size[0]}
            height={size[1]}
            quality="mid"
        />
    </div>
    <div class="service-title">
        {title.map((title_line) => (
            <p>{title_line}</p>
        ))}
    </div>

    <div class="service-overlay">
        <Image 
            src="/icons/lightning.svg"
            class="service-icon"
            alt=""
            width={115}
            height={191}
        />
        <p>{description}</p>
        <div class="service-button" aria-label={`View service: ${title}`}>
            <span class="arrow"></span>
        </div>
    </div>
</a>

<style>
    /* --- DESKTOP STYLES (Default) --- */
    .service-container {
        position: relative;
        display: block;
        width: 384px;
        height: 222px;
        overflow: hidden;
        margin: 10px;
        text-decoration: none;
        flex-shrink: 0; /* Prevents shrinking in the flex container */
    }

    .image-wrapper {
        height: calc(222px - 62px);
        overflow: hidden;
    }

    .service-image {
        transition: filter 0.5s ease;
        object-position: var(--pos-x) var(--pos-y);
        width: calc(100% - var(--pos-x, 0px));
        height: calc(100% - var(--pos-y, 0px));
        object-fit: cover;
        z-index: 0;
    }

    .service-title {
        display: flex;
        flex-direction: column;
        justify-content: center;
        background-color: var(--color-background-body);
        height: 62px;
        margin: 0;
        text-align: center;
        text-transform: uppercase;
        font-size: 14px;
        color: var(--color-text-primary);
    }

    .service-title > p {
        margin: 0;
    }

    .service-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        align-items: center;
        padding: 36px;
        background-color: var(--color-primary);
        color: var(--color-text-on-primary);
        opacity: 0;
        transition: opacity 0.5s ease;
    }
    
    .service-overlay p {
        text-align: center;
        font-weight: 400;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .service-icon {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translateX(-50%) translateY(-50%);
    }

    .service-button {
        position: absolute;
        padding: 10px;
        right: 20px;
        bottom: 22px;
        transition: transform 0.2s ease;
    }

    .arrow {
        position: relative;
    }

    .arrow::before {
        content: '';
        position: absolute;
        right: 5px;
        bottom: 8px;
        width: 7px;
        height: 7px;
        border-style: solid;
        border-color: var(--color-background-html);
        border-width: 1.5px 1.5px 0 0;
        transform: rotate(45deg);
    }

    /* HOVER EFFECTS */
    .service-container:hover .service-overlay {
        opacity: 1;
    }

    .service-container:hover .service-image {
        filter: blur(1px) brightness(80%);
    }

    .service-container:hover .service-button {
        transform: scale(1.2);
    }

    /* --- MOBILE STYLES --- */
    @media (max-width: 768px) {
        .service-container {
            width: 100%;
            max-width: 367px;
            
            margin: 10px;
        }
    }
</style>