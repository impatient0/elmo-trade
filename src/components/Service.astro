---
const { title, description, optimizedImageSrc, offsets, size, link } = Astro.props;
---

<a href={link} class="service-container">
    <div
        class="service-image"
        style={`--bg-image: url('${optimizedImageSrc}'); --bg-pos: ${offsets[0]}px ${offsets[1]}px; --bg-size: ${size[0]}px ${size[1]}px;`}
    />
    <div class="service-title">
        {title.map((title_line) => (
            <p>{title_line}</p>
        ))}
    </div>

    <div class="service-overlay">
        <img class="service-icon" src='/icons/lightning.svg' width="115" height="191" alt="" />
        <p>{description}</p>
        <div class="service-button">
            <img src='/icons/buttons/service-button.svg' width="7.5" height="15" alt="View service" />
        </div>
    </div>
</a>

<style>
    /* --- DESKTOP STYLES (Default) --- */
    .service-container {
        position: relative;
        display: block;
        width: 384px;
        height: 222px;
        overflow: hidden;
        margin: 10px;
        text-decoration: none;
        flex-shrink: 0; /* Prevents shrinking in the flex container */
    }

    .service-image {
        width: 100%;
        height: 160px;
        transition: filter 0.5s ease;
        background-image: var(--bg-image);
        background-position: var(--bg-pos);
        background-size: var(--bg-size);
    }

    .service-title {
        display: flex;
        flex-direction: column;
        justify-content: center;
        background-color: var(--color-background-body);
        height: 62px;
        margin: 0;
        text-align: center;
        text-transform: uppercase;
        font-size: 14px;
        color: var(--color-text-primary);
    }

    .service-title > p {
        margin: 0;
    }

    .service-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        align-items: center;
        padding: 36px;
        background-color: var(--color-primary);
        color: var(--color-text-on-primary);
        opacity: 0;
        transition: opacity 0.5s ease;
    }
    
    .service-overlay p {
        text-align: center;
        font-weight: 400;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .service-icon {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translateX(-50%) translateY(-50%);
    }

    .service-button {
        position: absolute;
        padding: 10px;
        right: 20px;
        bottom: 22px;
        transition: transform 0.2s ease;
    }

    /* HOVER EFFECTS */
    .service-container:hover .service-overlay {
        opacity: 1;
    }

    .service-container:hover .service-image {
        filter: blur(1px) brightness(80%);
    }

    .service-container:hover .service-button {
        transform: scale(1.2);
    }

    /* --- MOBILE STYLES --- */
    @media (max-width: 768px) {
        .service-container {
            width: 100%;
            max-width: 367px;
            
            margin: 10px;
        }
    }
</style>