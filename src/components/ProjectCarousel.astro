---
import ProjectCard from "./ProjectCard.astro";
const { slides, maxSlidesOnMobile = 999 } = Astro.props;
---

<div class="carousel-wrapper">
    <div class="carousel-viewport">
        <div class="slides-container">
            {slides.map((slide, index) => (
                <div class={"project-slide" + (index >= maxSlidesOnMobile ? " hide-on-mobile" : "")}>
                    <ProjectCard slide={slide} />
                </div>
            ))}
        </div>
        <button class="prev-btn" aria-label="Previous project"></button>        
        <button class="next-btn" aria-label="Next project"></button>
    </div>

    <!-- Navigation buttons and dots -->
    <div class="carousel-controls">
        <div class="dots-container">
            {slides.map((_, index) => (
                <button class="dot" data-index={index} aria-label={`Go to project ${index + 1}`}></button>
            ))}
        </div>
    </div>
</div>


<script>
    // All interactivity is now handled by this small, modern script.
    const wrapper = document.querySelector('.carousel-wrapper') as HTMLElement;
    const slidesContainer = wrapper.querySelector('.slides-container') as HTMLElement;
    const slides = wrapper.querySelectorAll('.project-slide') as NodeListOf<HTMLElement>;
    const nextBtn = wrapper.querySelector('.next-btn') as HTMLButtonElement;
    const prevBtn = wrapper.querySelector('.prev-btn') as HTMLButtonElement;
    const dots = wrapper.querySelectorAll('.dot') as NodeListOf<HTMLButtonElement>;

    const mediaQuery = window.matchMedia('(max-width: 1200px)');
    let isSingleSlideView = mediaQuery.matches;
    
    if (slides.length <= 2) {
        // Hide controls if there aren't enough slides to paginate
        (wrapper.querySelector('.carousel-controls') as HTMLElement).style.display = 'none';
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
    }
    
    if (dots.length > 0) {
        dots[slides.length - 1].style.display = isSingleSlideView ? 'block' : 'none';
    }

    let activeIndex = 0;
    let autoplayInterval = null;

    // --- MODIFIED: The core goToSlide function is now responsive ---
    function goToSlide(index) {
        let scrollOffset = 0;

        if (isSingleSlideView) {
            // --- Single-Slide Logic (for screens < 1200px) ---
            // Simple calculation to center the active slide
            scrollOffset = slides[index].offsetLeft - wrapper.offsetWidth / 2 + slides[index].offsetWidth / 2;
            
            // Update active classes for dots and a single slide
            if (dots.length > 0) dots[activeIndex]?.classList.remove('is-active');
            slides[activeIndex]?.classList.remove('is-active');
            
            activeIndex = index;
            
            if (dots.length > 0) dots[activeIndex]?.classList.add('is-active');
            slides[activeIndex]?.classList.add('is-active');

        } else {
            // --- Two-Slide Logic (for screens > 1200px) ---
            // Your original calculation to show two slides
            scrollOffset = slides[index].offsetLeft - wrapper.offsetWidth / 2 + slides[index].offsetWidth + 40;

            // Your original logic for managing active classes on two slides
            slides[activeIndex]?.classList.remove('is-active', 'left', 'right');
            slides[(activeIndex + 1) % slides.length]?.classList.remove('is-active', 'left', 'right');
            
            activeIndex = index;

            slides[activeIndex]?.classList.add('is-active', 'left');
            slides[(activeIndex + 1) % slides.length]?.classList.add('is-active', 'right');
        }
        
        // This part is the same for both modes
        if (dots.length > 0) dots.forEach((d, i) => d.classList.toggle('is-active', i === activeIndex));
        slidesContainer.style.transform = `translateX(-${scrollOffset}px)`;
    }

    // --- Autoplay is also slightly modified ---
    function startAutoplay() {
        stopAutoplay();
        const limit = isSingleSlideView ? slides.length : slides.length - 1;
        if (slides.length > (isSingleSlideView ? 1 : 2)) {
            autoplayInterval = setInterval(() => {
                const nextIndex = (activeIndex + 1) % limit;
                goToSlide(nextIndex);
            }, 4000);
        }
    }

    function stopAutoplay() {
        clearInterval(autoplayInterval);
    }

    // --- Event Listeners now use the correct limit ---
    function updateAndGoTo(newIndex) {
        const limit = isSingleSlideView ? slides.length : slides.length - 1;
        goToSlide((newIndex + limit) % limit);
    }

    nextBtn.addEventListener('click', () => updateAndGoTo(activeIndex + 1));
    prevBtn.addEventListener('click', () => updateAndGoTo(activeIndex - 1));
    dots.forEach(dot => {
        dot.addEventListener('click', () => goToSlide(parseInt(dot.dataset.index)));
    });

    wrapper.addEventListener('mouseenter', stopAutoplay);
    wrapper.addEventListener('mouseleave', startAutoplay);

    // --- NEW: Handle screen resizing ---
    function handleResize() {
        isSingleSlideView = mediaQuery.matches;
        // Re-hide the last dot if needed
        if (dots.length > 0) {
            dots[slides.length - 1].style.display = isSingleSlideView ? 'block' : 'none';
        }
        // Re-calculate the current slide's position for the new view
        goToSlide(activeIndex);
        // Restart autoplay with the correct logic
        startAutoplay();
    }

    mediaQuery.addEventListener('change', handleResize);

    // Initialize
    goToSlide(0);
    startAutoplay();
</script>

<style>
    .carousel-wrapper {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: var(--color-background-accent);
    }
    .carousel-viewport {
        padding: 10px 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        width: 100%;
        min-height: 412px;
        overflow: hidden; /* This hides the parts of the slides that are off-screen */
    }
    .slides-container {
        display: flex;
        align-items: center; /* Vertically align slides */
        position: relative;
        /* Add padding to allow first/last slides to center */
        padding: 0 calc(50% - 588px / 2);
        transition: transform 0.75s ease;
    }

    .project-slide {
        margin: 0 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        flex-shrink: 0;
        transition: transform 0.75s ease-out, opacity 0.5s ease-in-out;
        transform: scale(0.9);
    }
    .project-slide.is-active {
        transform: scale(1);
        opacity: 1;
    }
    .project-slide.is-active.left {
        transform: translateX(30px);
    }
    .project-slide.is-active.right {
        transform: translateX(-30px);
    }
    
    .carousel-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 0 0 30px;
    }
    .prev-btn, .next-btn {
        position: absolute;
        background: no-repeat center center;
        width: 30px;
        height: 30px;
        border: none;
        cursor: pointer;
        transition: transform 0.2s ease;
    }
    .prev-btn {
        left: 2%;
        top: 50%;
        transform: translateY(-50%);
        background-image: url("/icons/buttons/prev-btn.svg");
    }
    .next-btn {
        right: 2%;
        top: 50%;
        transform: translateY(-50%);
        background-image: url("/icons/buttons/next-btn.svg");
    }
    .prev-btn:hover, .next-btn:hover {
        transform: translateY(-50%) scale(1.1);
    }

    .dots-container {
        position: relative;
        display: flex;
        margin: 0 40px;
    }
    .dot {
        background-color: #CCCCCC;
        width: 10px;
        height: 10px;
        margin: 0 10px;
        border: none;
        padding: 0;
        cursor: pointer;
        transition: background-color 0.75s ease;
    }
    .dot.is-active {
        background-color: var(--color-primary);
    }
    .dot.is-hidden {
        display: none;
    }

    /* This media query makes it a single-slide carousel on smaller screens */
    @media (max-width: 1200px) {
        .slides-container {
            padding: 0 calc(50% - 588px / 2);
        }
        .project-slide {
            transform: scale(1); /* All slides are same size */
            margin: 0 140px;
        }
        .project-slide.is-active.left {
            transform: none;
        }
        .project-slide.is-active.right {
            transform: none;
        }
    }

    /* ==========================================================================
       MOBILE STYLES
       ========================================================================== */

    @media (max-width: 768px) {
        /* 1. Adjust the main wrapper's spacing */
        .carousel-wrapper {
            /* Use padding to create the 20px 14px "margin" you requested */
            padding: 20px 14px;
        }

        /* 2. Remove the "viewport" constraints */
        .carousel-viewport {
            overflow: visible; /* Let the content flow naturally */
            min-height: 0; /* Remove the fixed min-height */
            padding: 0;
        }

        /* 3. Transform the slides container into a vertical stack */
        .slides-container {
            flex-direction: column; /* The key to the vertical layout */
            
            /* Undo the desktop carousel styles */
            padding: 0;
            transform: none !important; /* Use !important to override the inline style from JS */
        }

        /* 4. Reset the individual slide styles */
        .project-slide {
            width: 100%; /* Make the slide fill the container width */
            margin: 0; /* Remove horizontal margins */
            
            /* Undo the desktop carousel styles */
            transform: none !important; /* Use !important to override JS and other styles */
            opacity: 1 !important;
        }

        .project-slide.hide-on-mobile {
            display: none;
        }

        /* 5. Hide all the carousel controls */
        .carousel-controls,
        .prev-btn,
        .next-btn {
            display: none;
        }

        .is-active.right:has(.is-placeholder) {
            display: none;
        }
    }
</style>