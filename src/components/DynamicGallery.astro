const { slides } = Astro.props;

// This helper function can now live and run on the server.
function convertIntervals(intervals) {
    const numbers = [];
    intervals.forEach(interval => {
        const [start, end] = interval.split('-').map(Number);
        if (end === undefined) {
            numbers.push(...interval.split(', ').map(Number));
        } else if (start <= end) {
            for (let i = start; i <= end; i++) {
                numbers.push(i);
            }
        }
    });
    return numbers;
}

const maxYearCount = 7; // Display only the latest 7 years

// --- NEW DYNAMIC YEAR LOGIC ---
// 1. Use a Set to store unique years.
const allYears = new Set<number>();

// 2. Loop through all slides and add their years to the Set.
slides.forEach(slide => {
    const projectYears = convertIntervals(slide.year);
    projectYears.forEach(year => allYears.add(year));
});

// 3. Convert the Set to an array and sort it descending.
const years = Array.from(allYears).sort((a, b) => b - a).slice(0, maxYearCount);
---

<div class="dynamic-gallery-container">
    <div class="filter-controls">
        <button class="filter-button is-active" data-filter="all">Все проекты</button>
        {years.map((year, index) => (
            <button class="filter-button" data-filter={year}>
                {year}{index === years.length - 1 ? " и ранее" : ""}
            </button>
        ))}
    </div>
    <div class="dynamic-gallery">
        {slides.map((slide) => {
            const projectYears = convertIntervals(slide.year);
            // We add data attributes to each project card with its years.
            // This allows our script to easily find and filter them.
            return (
                <article class="project-card" data-years={JSON.stringify(projectYears)}>
                    <div class="image-wrapper">
                        <img class="project-image" src={slide.optimizedSrc} alt={`Image of ${slide.title}`} style={`--pos-x: ${slide.offsets[0]}px; --pos-y: ${slide.offsets[1]}px;`} loading="lazy" />
                    </div>
                    <div class="project-footer">
                        <p class="project-title">{slide.title}</p>
                        <p class="subbody2">{slide.address}</p>
                    </div>
                    <div class="project-year">
                        {slide.year.map((y) => <p class="body2">{y !== "0" ? y : "Выполнено"}</p>)}
                    </div>
                    <a href={slide.link} class="info-overlay" aria-label={`View details for ${slide.title}`}>
                        <div class="info-content"><p>{slide.info}</p></div>
                    </a>
                </article>
            );
        })}
    </div>
</div>

<script define:vars={{ years }}>
    const container = document.querySelector('.dynamic-gallery-container');
    const filterButtons = container.querySelectorAll('.filter-button');
    const gallery = container.querySelector('.dynamic-gallery');
    const projectCards = Array.from(container.querySelectorAll('.project-card')); // Convert to Array for .filter

    let activeFilter = 'all';

    function updateLayout() {
        const containerWidth = gallery.offsetWidth;
        const cardStyle = getComputedStyle(projectCards[0]);
        const cardWidth = parseFloat(cardStyle.width);
        const cardMargin = parseFloat(cardStyle.marginLeft) + parseFloat(cardStyle.marginRight);
        const galleryPadding = parseFloat(getComputedStyle(gallery).padding);
              
        const cardsPerRow = Math.max(Math.floor(containerWidth / (cardWidth + cardMargin)), 1);
        
        let visibleCards = [];
        if (activeFilter === 'all') {
            visibleCards = projectCards;
        } else {
            const filterYear = parseInt(activeFilter);
            const isLastFilter = filterYear === years[years.length - 1];

            visibleCards = projectCards.filter(card => {
                const cardYears = JSON.parse(card.dataset.years);
                return cardYears.includes(filterYear) || (isLastFilter && cardYears[0] <= filterYear);
            });
        }
        
        // Hide cards that are not visible
        projectCards.forEach(card => {
            if (!visibleCards.includes(card)) {
                card.classList.add('is-collapsed');
            } else {
                card.classList.remove('is-collapsed');
            }
        });

        // Position the visible cards
        let x = 0;
        let y = 0;
        let col = 0;
        let prevRowHeight = 0;
        visibleCards.forEach((card, index) => {
            const left = (col - cardsPerRow / 2) * (cardWidth + cardMargin) + x;
            const top = y + galleryPadding;
            card.style.transform = `translate(${left}px, ${top}px)`;
            prevRowHeight = Math.max(prevRowHeight, parseFloat(getComputedStyle(card).height));

            col++;
            if (col >= cardsPerRow) {
                col = 0;
                y += prevRowHeight + parseFloat(cardStyle.marginTop) + parseFloat(cardStyle.marginBottom);
                prevRowHeight = 0;
            }
        });
        
        // Update the container height
        const containerHeight = y + prevRowHeight + galleryPadding * 2;
        gallery.style.height = `${containerHeight}px`;
    }

    function handleFilterClick(event) {
        const clickedButton = event.currentTarget;
        activeFilter = clickedButton.dataset.filter;

        filterButtons.forEach(btn => btn.classList.remove('is-active'));
        clickedButton.classList.add('is-active');

        // Trigger the layout update
        updateLayout();
    }

    filterButtons.forEach(button => {
        button.addEventListener('click', handleFilterClick);
    });
    
    // Initial layout and listen for resizes
    updateLayout();
    window.addEventListener('resize', updateLayout);
</script>


<style>
    /* All styles are now scoped and self-contained */
    .dynamic-gallery-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        overflow: hidden;
    }
    .filter-controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-bottom: 2rem;
    }
    .filter-button {
        border: 1px solid #D6D6D6;
        border-radius: 3px;
        background: none;
        padding: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .filter-button.is-active {
        background-color: var(--color-primary);
        color: var(--color-text-on-primary);
        border-color: var(--color-primary);
    }
    .filter-button:not(.is-active):hover {
        background-color: #f0f0f0;
    }

    .dynamic-gallery {
        width: 100%;
        background-color: var(--color-background-accent);
        padding: 40px;
        position: relative; /* This is the key for absolute positioning of children */
        transition: height 0.4s ease; /* Animate the container's height change */
    }

    .project-card {
        width: 588px; /* Or your desired card width */
        height: fit-content;
        margin: 10px; /* Use margin for spacing */
        
        /* --- Animation --- */
        position: absolute; /* All cards are now positioned absolutely */
        left: 50%;
        top: 0;
        transition: transform 0.6s ease, opacity 0.6s ease;
    }

    .project-card.is-collapsed {
        opacity: 0;
        transform: scale(0.8);
        pointer-events: none; /* Prevent interacting with hidden cards */
    }

    /* Reused styles for card content */
    .image-wrapper { width: 100%; height: 283px; overflow: hidden; }
    .project-image {
        object-position: var(--pos-x) var(--pos-y);
        width: calc(100% - var(--pos-x, 0px));
        height: calc(100% - var(--pos-y, 0px));
        object-fit: cover;
    }
    .project-footer { background-color: var(--color-background-body); padding: 20px; }
    .project-footer > p { margin: 2px; }
    .project-title { font-size: 16px; font-weight: 500; text-transform: uppercase; }
    .project-year { position: absolute; top: 20px; right: 20px; padding: 13px 20px; background-color: var(--color-background-body); text-align: right; }
    .project-year > p { margin: 0; }
    
    .info-overlay {
        cursor: pointer; position: absolute; inset: 0;
        background-color: var(--color-primary);
        display: flex; justify-content: center; align-items: center;
        transition: opacity 0.5s ease; opacity: 0;
        background-image: url('/icons/lightning.svg');
        background-size: 175px; background-position: center; background-repeat: no-repeat;
        text-decoration: none;
    }
    .info-overlay:hover { opacity: 1; }
    .info-content > p { text-align: center; color: var(--color-text-on-primary); font-size: 14px; max-width: 456px; }

    /* ==========================================================================
       MOBILE STYLES
       ========================================================================== */
    @media (max-width: 768px) {
        /* Adjust the main container's padding for mobile */
        .dynamic-gallery {
            padding: 20px 0; /* Less vertical, no horizontal padding */
        }

        /* --- 1. Adjust the project card size --- */
        .project-card {
            /* 
                This calculation ensures there is always 14px of space on either side.
                `100vw` is the full viewport width.
                `28px` is 14px on the left + 14px on the right.
            */

            width: calc(100vw - 28px);
            max-width: 440px;
            margin: 8px 0; /* Adjust vertical margin for the new layout */
        }
        
        /* Adjust the image wrapper height to match the new card proportions */
        .image-wrapper {
            height: 180px;
        }

        /* --- 2. Reduce padding in the footer --- */
        .project-footer {
            padding: 12px 14px;
        }
        
        /* --- 3. Reduce padding in the year badge --- */
        .project-year {
            padding: 8px 12px; /* Swapped to match standard padding order (vertical horizontal) */
        }

        /* Optional: Style tweaks for filter buttons on mobile */
        .filter-controls {
            padding: 27px 32px 16px;
            gap: 12px;
            margin: 0;
        }
        .filter-button {
            font-size: 14px;
            padding: 7px;
            font-size: 16px;
        }
        .filter-button:not(.is-active) {
            font-weight: 350;
        }
    }
</style>