---
const { showIcons = true, variant } = Astro.props;

const info = [
    {
        label: "Наш телефон",
        items: [
            { text: "+7 (812) 370-14-10", link: "tel:+78123701410" },
            { text: "+7 (812) 370-22-61", link: "tel:+78123702261" },
        ],
        icon: { path: "/icons/phone-solid.svg", width: 21, height: 28 },
    },
    {
        label: "Email",
        items: [
            { text: "elmotreid@mail.ru", link: "mailto:elmotreid@mail.ru" },
        ],
        icon: { path: "/icons/envelope-solid.svg", width: 21, height: 21 },
    },
    {
        label: "Офис",
        items: [
            { text: "Ленинский пр., 168, оф. 331", link: "https://yandex.ru/maps/?text=Санкт-Петербург, Ленинский пр., 168, оф. 331", target: "_blank" },
        ],
        icon: { path: "/icons/location-dot-solid.svg", width: 21, height: 28 },
    },
];

const bannerClass = ["contact-info-banner", variant && `${variant}-variant`].join(" ");
---

<div class={bannerClass}>
    {
        info.map((infoItem) => (
            <div class="contact-info-line">
                {showIcons && (
                    <img
                        class="icon"
                        src={infoItem.icon.path}
                        alt="Icon"
                        width={infoItem.icon.width}
                        height={infoItem.icon.height}
                        loading="lazy"
                    />
                )}
                <div>
                    <p class="title2">{infoItem.label}</p>
                    {infoItem.items.map((item) => (
                        <a 
                            class="contact-info-text" 
                            href={item.link}
                            target={item.target}
                            rel={item.target === '_blank' ? 'noopener noreferrer' : null}
                        >
                            {item.text}
                        </a>
                    ))}
                </div>
            </div>
        ))
    }
</div>

<style>
    .contact-info-banner {
        position: absolute;
        width: 38%;
        height: 70%;
        z-index: 1;
        top: 15%;
        background-color: #0D7EE1;
        display: flex;
        padding: 20px 90px;
        justify-content: space-evenly;
        flex-direction: column;
    }

    .contact-info-line {
        display: flex;
        align-items: center;
    }

    .contact-info-text {
        font-size: 20px;
        font-weight: 500;
        text-decoration: none;
        color: inherit;
        transition: opacity 0.2s ease;
    }

    .contact-info-text:hover {
        opacity: 0.8;
    }

    .contact-info-line>div>* {
        margin: .25em 24px;
        color: white;
        max-width: 325px;
        display: block;
    }

    .contact-info-banner.menu-variant {
        position: relative;
        width: 100%;
        padding-left: 50px;

        height: 100%;
        justify-content: space-around;
        padding-bottom: 20%;
    }

    .contact-info-banner.footer-variant {
        position: relative;
        width: 100%;
        padding: 20px 0 20px 11px;
        
        height: 280px;
        justify-content: space-between;
    }

    .footer-variant .contact-info-text {
        color: var(--color-text-secondary);
    }    

    @media (max-width: 768px) {
        .contact-info-banner:not(.menu-variant, .footer-variant) {
            display: none;
        }
    }
</style>